---
import '@fontsource/unbounded/600.css';
import '@fontsource/unbounded/800.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';

interface Props { lang: 'zh' | 'en' }
const { lang } = Astro.props;
const base = lang === 'zh' ? '' : '/en';
const t = {
	zh: {
		htmlLang: 'zh-CN', switchLabel: 'EN', switchHref: '/en/',
		nav: [['文档', '/guide/install/'], ['博物馆', '#museum'], ['开发者', '#dev'], ['GitHub', 'https://github.com/MujoVerse']],
		kicker: 'MuJoCo × Minecraft · 开源模组系列',
		title: ['真实的机器人，', '真实的物理，', '在你的世界里。'],
		lede: '每个关节都由电机力矩驱动，每一步都由学习型控制器决定，MuJoCo 每 2 毫秒解一次接触。没有一帧是动画。',
		cta1: '网页试玩', cta2: '阅读文档',
		chips: ['Fabric 1.21.1', 'Windows · Linux · macOS', '5 台实时机器人 + 33 款展品', '免费开源'],
		hudRobot: 'T2 · 31 自由度 · WALK', hudCaption: 'WALK 控制器带球进门',
		notAnim: '这一锤不是动画',
		notAnimText: '物理重锤在命中点施加冲量，T2 倒地；学到的起身控制器接管身体，翻身、撑地、站起，再把控制交回 WALK。整个过程都是物理计算，没有预设关键帧。',
		modsTitle: '四个模组，一个宇宙',
		mods: [
			['MujoCraft', '/icons/physics_hammer.png', '物理底座', '把 MuJoCo 接进 Minecraft：任何方块都能变成刚体；物理重锤、刚体装配杖；与瓦尔基里天空的船体相互碰撞。', '—'],
			['MujoBots', '/icons/robot_capsule.png', '机器人', 'Booster T2、K1、T1，宇树 G1 与 Go1：五台实时物理机器人，各由学习型策略驱动；33 款展品配展台与信息卡；投影阴影，兼容 Iris 光影。', 'MujoCraft'],
			['MinePilot', '/icons/t2_remote.png', '驾驶', '接管一台机器人，用 WASD 走、用鼠标转头，第一或第三人称，地面点选导航，倒地按 H 起身。也可以交给程序或 AI：本机 WebSocket 桥接、Python 包与 MCP 服务器。', 'MujoBots'],
			['MineArena', '/icons/arena_capsule.png', '竞技', 'RoboCup 规则的机器人足球：内置官方 GameController，1v1 到 5v5；成年组 14 × 9 米球场，倒地的机器人由裁判按规则拾起。', 'MujoBots'],
		],
		dependsOn: '依赖',
		museumTitle: 'MujoVerse 机器人博物馆',
		museumText: '一份可以直接打开的存档。序厅讲机器人简史，三个展厅陈列 33 款机器人，物理实验室里可以自己装配刚体、挥锤、召唤实时机器人，"参考 vs 执行"展区对照 G1 的生成动作与物理执行。',
		museumStats: [['33', '展品'], ['6', '展区'], ['0', '额外模组']],
		museumNote: '桌面试玩包内置展品、G1 和 Go1，在物理实验室可以重置刚体塔并召唤机器人。',
		museumWebNote: '网页试玩保留原版方块馆舍。机器人和物理机关请在桌面版体验。',
		museumGuide: '下载桌面试玩',
		fpvTitle: '从机身视角飞过展场',
		fpvText: 'MujoBots 的四旋翼由四个电机施力，MinePilot 提供手飞。辅助模式松杆悬停，Acro 不自动回正；FPV 跟随机身俯仰和横滚，稳拍则保持地平线水平。',
		fpvCaption: '开发版游戏实录：穿过青门，侧倾后切换到稳拍。',
		fpvGuide: 'FPV 飞行指南',
		newTitle: '开发版新进展',
		collisionTitle: '实体碰撞与移动平台',
		collisionText: '玩家可以推挤刚体，刚体可以推挤原版生物。玩家站在平台上会随它平移、升降和转动，跳起即可脱离。',
		ragdollTitle: '可推挤的关节布娃娃',
		ragdollText: '用 MuJoCo 联动求解肢体、关节和地形接触。布娃娃没有行走或起身控制器。',
		toolsNote: 'MujoBots 遥控器加入只读关节与深度视图；F7 打开机器人图鉴。MineArena 的赛事管理界面可在比赛中查看状态并按权限管理。',
		catalogueTitle: '机器人图鉴',
		catalogueText: '来自 MuJoCo Menagerie 与 Booster booster_assets 的公开模型，逐一核对许可后收录，每台都随附原始 LICENSE。放下胶囊就是一台展品，右键切换动作，看向它就弹出信息卡。',
		physicsTitle: '方块也有质量',
		physicsText: '转台把金块甩出去，跷跷板上的方块来回滑动，400 kg 的箱子把冰面雪橇撞出 3.8 米：MuJoCo 刚体与瓦尔基里天空船体之间的双向接触，在 1.20.1 适配模块里实测。',
		physicsCaps: ['转台 16 RPM', '箱子撞上雪橇', '跷跷板'],
		liveTitle: '五台机器人，各有各的大脑',
		liveText: '每台实时机器人都带着自己的学习型策略：T2 与 G1 走路、起身、带球；K1 与 T1 用 B-Human 2026 公开的网络行走和踢球；Go1 用 MuJoCo Playground 的摇杆策略。同一步物理里，它们互相碰撞、绊倒、再爬起来。',
		liveClips: [
			['k1-go1', 'Booster K1 与宇树 Go1 并肩走过大厅'],
			['tower-fall', '物理重锤四连击：一整座刚体塔被推倒'],
			['ai-drive', '由 agent 驾驶：语义指令走、转、导航到目标点'],
			['replay', '左：生成的参考动作；右：SONIC 在物理里做出来的'],
		],
		arenaTitle: '把你的 3v3 策略带进来',
		arenaText: 'Booster Champion 仿真赛的 3v3 示例策略（MIT，未改动一个字节）可以直接在 MineArena 里驱动 K1 与 T1：同样的 play(context, players, store)，同样的 GameController 状态。下面是一整场半场里的片段，双方都是 AI。',
		arenaNote: 'MujoVerse 是独立的开源项目，与 Booster Robotics 无隶属关系。',
		arenaLink: ['如何运行', '/guide/football/'],
		devTitle: '给开发者',
		devText: '机器人通过语义接口控制：认领控制权、在每个物理步里下达 walk / head / recover，拿到同一步的观测。下面这个控制源让机器人朝世界原点走。',
		devNext: ['进程内 Java API', '现在可用'],
		devSoon: ['Python 桥接 minepilot', '可用：WebSocket + JSON，只绑定本机，附 MCP 服务器'],
		devRec: ['轨迹记录导出', '可用：qpos、动作、接触力，npz 格式'],
		devLinks: [['从源码构建', '/dev/build/'], ['控制 API', '/dev/api/'], ['添加展品', '/dev/exhibits/']],
		credits: '致谢：MuJoCo（Google DeepMind）· MuJoCo Menagerie · Booster Robotics · Unitree Robotics · B-Human · MuJoCo Playground · NVIDIA SONIC / ARDY · Fabric · RoboCup GameController',
		footer: '代码采用 Apache-2.0；模型与权重各自保留原始许可，见各仓库 THIRD_PARTY_NOTICES。Minecraft 是 Mojang 的商标，本项目与 Mojang 无关。',
	},
	en: {
		htmlLang: 'en', switchLabel: '中文', switchHref: '/',
		nav: [['Docs', '/en/guide/install/'], ['Museum', '#museum'], ['Developers', '#dev'], ['GitHub', 'https://github.com/MujoVerse']],
		kicker: 'MuJoCo × Minecraft · open-source mod series',
		title: ['Real robots.', 'Real physics.', 'In your world.'],
		lede: 'Every joint is driven by motor torque, every step chosen by a learned controller, and MuJoCo solves contacts every 2 ms. Not a single frame is animation.',
		cta1: 'Play in browser', cta2: 'Read the docs',
		chips: ['Fabric 1.21.1', 'Windows · Linux · macOS', '5 live robots + 33 exhibits', 'Free & open source'],
		hudRobot: 'T2 · 31 DoF · WALK', hudCaption: 'The WALK controller dribbles the ball into the goal',
		notAnim: 'This hit is not an animation',
		notAnimText: 'The physics hammer applies an impulse where it lands and T2 goes down. A learned get-up controller takes over the body, rolls, braces and stands, then hands control back to WALK — all simulated, no keyframes.',
		modsTitle: 'Four mods, one universe',
		mods: [
			['MujoCraft', '/icons/physics_hammer.png', 'Physics', 'MuJoCo inside Minecraft: turn any blocks into a rigid body, swing the physics hammer, collide with Valkyrien Skies ships.', '—'],
			['MujoBots', '/icons/robot_capsule.png', 'Robots', 'Booster T2, K1 and T1, Unitree G1 and Go1: five live physical robots, each driven by a learned policy; 33 exhibits with pedestals and info cards; pose-accurate shadows, Iris aware.', 'MujoCraft'],
			['MinePilot', '/icons/t2_remote.png', 'Driving', 'Take over a robot: walk with WASD, look with the mouse, first or third person, point-and-go ground targets, press H to get up. Or hand it to a program or an AI: a localhost WebSocket bridge, a Python package and an MCP server.', 'MujoBots'],
			['MineArena', '/icons/arena_capsule.png', 'Arena', 'RoboCup-style robot football with the official GameController embedded: 1v1 up to 5v5, an adult 14 × 9 m pitch, and a referee that picks up fallen robots by the rules.', 'MujoBots'],
		],
		dependsOn: 'needs',
		museumTitle: 'The MujoVerse Museum of Robots',
		museumText: 'A world you can just open. A history wing, three halls with 33 robots, a physics lab where you assemble rigid bodies, swing the hammer and summon live robots, and a gallery comparing G1’s generated motion with its physical execution.',
		museumStats: [['33', 'exhibits'], ['6', 'wings'], ['0', 'extra mods']],
		museumNote: 'The desktop preview includes the exhibits, G1 and Go1. Visit the physics lab to reset the rigid-body towers and spawn the live robots.',
		museumWebNote: 'The browser demo includes the vanilla-block museum. Robot exhibits and physics interactions require the desktop mods.',
		museumGuide: 'Download desktop demo',
		fpvTitle: 'Fly the course in first person',
		fpvText: 'Four motors drive the MujoBots quadrotor, and MinePilot lets you fly it. Assisted mode holds position after you release the controls; Acro does not self-level. The FPV camera follows the airframe while the stabilized camera keeps the horizon level.',
		fpvCaption: 'In-game development capture: through the cyan gate, then from a bank into stabilized view.',
		fpvGuide: 'FPV flight guide',
		newTitle: 'New in Development',
		collisionTitle: 'Entity collisions and moving platforms',
		collisionText: 'Players can push rigid bodies, and rigid bodies can push vanilla mobs. Standing players follow a platform as it moves, lifts, and rotates; jumping detaches them.',
		ragdollTitle: 'Articulated ragdolls',
		ragdollText: 'MuJoCo solves limb, joint, and terrain contact together. These are physics props with no walking or recovery controller.',
		toolsNote: 'The MujoBots remote adds read-only joint and depth views, and F7 opens the robot catalogue. MineArena exposes match status and permission-checked actions in its management screen.',
		catalogueTitle: 'Robot catalogue',
		catalogueText: 'Public robot descriptions from MuJoCo Menagerie and Booster’s booster_assets, each licence checked and shipped with its original LICENSE. Place a capsule to get an exhibit, right-click to change its motion, look at it for the info card.',
		physicsTitle: 'Blocks have mass',
		physicsText: 'A turntable flings gold blocks off its deck, blocks slide across a see-saw, a 400 kg crate pushes an ice sled 3.8 m: two-way contact between MuJoCo bodies and Valkyrien Skies ships, measured in the 1.20.1 bridge.',
		physicsCaps: ['Turntable at 16 RPM', 'Crate hits the sled', 'See-saw'],
		liveTitle: 'Five robots, five brains',
		liveText: 'Each live robot carries its own learned policy: T2 and G1 walk, get up and dribble; K1 and T1 walk and kick with networks from the B-Human 2026 code release; Go1 runs the MuJoCo Playground joystick policy. In the same physics step they bump, trip and get back up.',
		liveClips: [
			['k1-go1', 'Booster K1 and Unitree Go1 walk through the lobby'],
			['tower-fall', 'Four hits with the physics hammer topple a rigid tower'],
			['ai-drive', 'Driven by an agent: semantic walk, turn and go-to-target commands'],
			['replay', 'Left: generated reference motion. Right: SONIC doing it in physics'],
		],
		arenaTitle: 'Bring your 3v3 strategy',
		arenaText: 'The Booster Champion simulation 3v3 example strategy (MIT, not a single byte changed) drives K1 and T1 in MineArena directly: the same play(context, players, store), the same GameController state. Below, a stretch of a full half, AI on both sides.',
		arenaNote: 'MujoVerse is an independent open-source project, not affiliated with Booster Robotics.',
		arenaLink: ['How to run it', '/en/guide/football/'],
		devTitle: 'For developers',
		devText: 'Robots are controlled through a semantic API: claim control, issue walk / head / recover each physics step, read the same step’s observation. This control source walks a robot toward the world origin.',
		devNext: ['In-process Java API', 'available now'],
		devSoon: ['Python bridge minepilot', 'available: WebSocket + JSON, localhost only, with an MCP server'],
		devRec: ['Trajectory recording', 'available: qpos, actions, contact forces as npz'],
		devLinks: [['Build from source', '/en/dev/build/'], ['Control API', '/en/dev/api/'], ['Add an exhibit', '/en/dev/exhibits/']],
		credits: 'Credits: MuJoCo (Google DeepMind) · MuJoCo Menagerie · Booster Robotics · Unitree Robotics · B-Human · MuJoCo Playground · NVIDIA SONIC / ARDY · Fabric · RoboCup GameController',
		footer: 'Code under Apache-2.0; models and weights keep their own licences, see each repository’s THIRD_PARTY_NOTICES. Minecraft is a trademark of Mojang; this project is not affiliated with Mojang.',
	},
}[lang];
const docs = (p: string) => p;
const frames = ['0.0', '0.8', '2.0', '3.2', '4.8', '5.6', '6.4'];
---
<!doctype html>
<html lang={t.htmlLang}>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>MujoVerse — {t.title.join(' ')}</title>
	<meta name="description" content={t.lede} />
	<link rel="icon" href="/favicon-48.png" type="image/png" />
	<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
	<meta property="og:image" content="https://mujoverse.github.io/media/museum-lobby-shaders.webp" />
</head>
<body>
	<div class="grain" aria-hidden="true"></div>
	<header class="bar">
		<a class="brand" href={lang === 'zh' ? '/' : '/en/'}>
			<img src="/avatar-256.png" alt="" width="30" height="30" /><span>MujoVerse</span>
		</a>
		<nav>
			{t.nav.map(([label, href]) => <a href={href}>{label}</a>)}
			<a class="lang" href={t.switchHref}>{t.switchLabel}</a>
		</nav>
	</header>

	<main>
		<section class="hero">
			<div class="hero-copy">
				<p class="kicker">{t.kicker}</p>
				<h1>{t.title.map((line, i) => <span style={`--d:${i * 120}ms`}>{line}</span>)}</h1>
				<p class="lede">{t.lede}</p>
				<div class="ctas">
					<a class="btn primary" href={`${base}/demo/`}>{t.cta1} →</a>
					<a class="btn" href={`${base}/guide/museum/`}>{t.museumGuide}</a>
					<a class="btn" href={docs(`${base}/guide/install/`)}>{t.cta2}</a>
				</div>
				<ul class="chips">{t.chips.map((c) => <li>{c}</li>)}</ul>
			</div>
			<div class="monitor-wrap">
			<figure class="monitor">
				<video src="/media/dribble.mp4" poster="/media/live-robots.webp" autoplay muted loop playsinline></video>
				<div class="hud" aria-hidden="true">
					<span class="tl">SIM <b id="simt">0.000</b> s</span>
					<span class="tr">STEP <b id="steps">0</b></span>
					<span class="bl">PHYSICS 2 ms · POLICY 50 Hz</span>
					<span class="br">{t.hudRobot}</span>
					<i class="corner c1"></i><i class="corner c2"></i><i class="corner c3"></i><i class="corner c4"></i>
				</div>
			</figure>
			<p class="monitor-caption">{t.hudCaption}</p>
			</div>
		</section>

		<section class="arena fpv" id="fpv">
			<div class="arena-copy">
				<p class="kicker">MujoBots × MinePilot · FPV</p>
				<h2>{t.fpvTitle}</h2>
				<p>{t.fpvText}</p>
				<a class="btn" href={`${base}/guide/fpv/`}>{t.fpvGuide} →</a>
			</div>
			<figure class="new-media">
				<video src="/media/fpv-flight.mp4" poster="/media/fpv-flight.webp" controls muted playsinline preload="none"></video>
				<figcaption>{t.fpvCaption}</figcaption>
			</figure>
		</section>

		<section class="strip">
			<h2>{t.notAnim}</h2>
			<p>{t.notAnimText}</p>
			<ol class="film">
				{frames.map((s, i) => (
					<li style={`--i:${i}`}><img src={`/media/getup-${i}.webp`} alt="" loading="lazy" width="400" height="300" /><span>t = {s} s</span></li>
				))}
			</ol>
		</section>

		<section class="live">
			<h2>{t.liveTitle}</h2>
			<p>{t.liveText}</p>
			<div class="reel">
				{t.liveClips.map(([clip, cap], i) => (
					<figure style={`--i:${i}`}>
						<video src={`/media/${clip}.mp4`} poster={`/media/${clip}.webp`} muted loop playsinline preload="none" data-autoplay></video>
						<figcaption><span class="idx">{String(i + 1).padStart(2, '0')}</span>{cap}</figcaption>
					</figure>
				))}
			</div>
		</section>

		<section class="arena" id="arena">
			<div class="arena-copy">
				<p class="kicker">MineArena · 3v3</p>
				<h2>{t.arenaTitle}</h2>
				<p>{t.arenaText}</p>
				<p class="note">{t.arenaNote}</p>
				<a class="btn" href={docs(t.arenaLink[1])}>→ {t.arenaLink[0]}</a>
			</div>
			<figure class="pitch">
				<video src="/media/football-3v3.mp4" poster="/media/football-3v3.webp" muted loop playsinline preload="none" data-autoplay></video>
				<div class="scoreline" aria-hidden="true"><span>HOME</span><b>CHAMPION EXAMPLE</b><i>vs</i><b>BUILTIN AI</b><span>AWAY</span></div>
			</figure>
		</section>

		<section class="mods">
			<h2>{t.modsTitle}</h2>
			<div class="grid">
				{t.mods.map(([name, icon, role, text, dep]) => (
					<article class="card">
						<header><img class="px" src={icon} alt="" width="40" height="40" /><div><h3>{name}</h3><p class="role">{role}</p></div></header>
						<p>{text}</p>
						<p class="dep"><span>{t.dependsOn}</span> {dep}</p>
					</article>
				))}
			</div>
		</section>

		<section class="museum" id="museum">
			<div class="mosaic">
				<img class="a" src="/media/museum-lobby-shaders.webp" alt="" loading="lazy" />
				<img class="b" src="/media/hall-humanoid-shaders.webp" alt="" loading="lazy" />
				<img class="c" src="/media/replay-gallery.webp" alt="" loading="lazy" />
				<img class="d" src="/media/physics-lab.webp" alt="" loading="lazy" />
			</div>
			<div class="museum-copy">
				<h2>{t.museumTitle}</h2>
				<p>{t.museumText}</p>
				<dl class="stats">{t.museumStats.map(([n, l]) => <div><dt>{n}</dt><dd>{l}</dd></div>)}</dl>
				<p class="note">{t.museumNote} {t.museumWebNote}</p>
				<div class="ctas">
					<a class="btn primary" href={`${base}/demo/`}>{t.cta1} →</a>
					<a class="btn" href={docs(`${base}/guide/museum/`)}>{t.museumGuide}</a>
				</div>
			</div>
		</section>

		<section class="catalogue">
			<div class="cat-copy"><h2>{t.catalogueTitle}</h2><p>{t.catalogueText}</p>
				<img class="card-shot" src="/media/info-card.webp" alt="" loading="lazy" /></div>
			<img class="cat-img" src="/media/exhibit-catalogue.webp" alt="" loading="lazy" />
		</section>

		<section class="physics">
			<h2>{t.physicsTitle}</h2>
			<p>{t.physicsText}</p>
			<div class="trio">
				{['vs2-turntable', 'vs2-sled', 'vs2-seesaw'].map((img, i) => (
					<figure><img src={`/media/${img}.webp`} alt="" loading="lazy" /><figcaption>{t.physicsCaps[i]}</figcaption></figure>
				))}
			</div>
		</section>

		<section class="updates" id="updates">
			<p class="kicker">MujoCraft · MujoBots · MineArena</p>
			<h2>{t.newTitle}</h2>
			<div class="update-grid">
				<article>
					<figure class="new-media"><img src="/media/moving-platform.webp" width="960" height="540" alt={t.collisionTitle} loading="lazy" /></figure>
					<h3>{t.collisionTitle}</h3>
					<p>{t.collisionText}</p>
				</article>
				<article>
					<figure class="new-media"><video src="/media/ragdoll.mp4" poster="/media/ragdoll.webp" controls muted playsinline preload="none"></video></figure>
					<h3>{t.ragdollTitle}</h3>
					<p>{t.ragdollText}</p>
				</article>
			</div>
			<p>{t.toolsNote}</p>
		</section>

		<section class="dev" id="dev">
			<div>
				<h2>{t.devTitle}</h2>
				<p>{t.devText}</p>
				<ul class="status">
					<li><b>{t.devNext[0]}</b><span class="ok">{t.devNext[1]}</span></li>
					<li><b>{t.devSoon[0]}</b><span>{t.devSoon[1]}</span></li>
					<li><b>{t.devRec[0]}</b><span>{t.devRec[1]}</span></li>
				</ul>
				<p class="links">{t.devLinks.map(([l, h]) => <a href={docs(h)}>{l} →</a>)}</p>
			</div>
			<pre class="code"><code>{`public final class GoHome implements RobotControlSource {
  @Override
  public void beforeStep(RobotControlContext ctx) {
    RobotObservation o = ctx.observation();
    Vec3d p = o.rootPosition();
    double heading = Math.atan2(p.z, -p.x);   // toward 0,0
    double turn = MathHelper.wrapDegrees(
        Math.toDegrees(heading - o.yaw())) / 45.0;
    ctx.walk(p.horizontalLength() > 1 ? 0.6 : 0,
             0, Math.clamp(turn, -1, 1));
  }
}

// robot.claimControl(new GoHome());`}</code></pre>
		</section>
	</main>

	<footer class="foot">
		<p>{t.credits}</p>
		<p class="fine">{t.footer}</p>
	</footer>

	<script>
		const sim = document.getElementById('simt');
		const steps = document.getElementById('steps');
		const start = performance.now();
		const tick = () => {
			const s = (performance.now() - start) / 1000;
			if (sim) sim.textContent = s.toFixed(3);
			if (steps) steps.textContent = Math.floor(s * 500).toLocaleString('en');
			requestAnimationFrame(tick);
		};
		if (!matchMedia('(prefers-reduced-motion: reduce)').matches) requestAnimationFrame(tick);
		// Clips load lazily and play only while visible (saves bandwidth and battery).
		const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const io = new IntersectionObserver((entries) => {
			for (const e of entries) {
				const v = e.target;
				if (v.tagName === 'VIDEO') {
					if (e.isIntersecting && !reduce) { v.preload = 'auto'; v.play().catch(() => {}); } else v.pause();
				} else if (e.isIntersecting) v.classList.add('seen');
			}
		}, { threshold: 0.25 });
		document.querySelectorAll('video[data-autoplay], .reel').forEach((el) => io.observe(el));
	</script>
</body>
</html>

