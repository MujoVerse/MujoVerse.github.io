---
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Focus from '@lucide/astro/icons/focus';
import Hammer from '@lucide/astro/icons/hammer';
import RotateCcw from '@lucide/astro/icons/rotate-ccw';
import { towers } from '../museum/tower-simulation.js';

const { lang } = Astro.props;
const zh = lang === 'zh';
const home = zh ? '/' : '/en/';
const alternate = zh ? '/en/playtest/' : '/playtest/';
const t = zh ? {
	title: '模组试玩', section: '刚体塔实验室', web: '网页试玩', home: '返回首页', language: 'English',
	loading: '正在加载物理场景…', live: '实时仿真', offline: '仿真未运行',
	unavailable: '此设备未能启动仿真。可以继续参观馆舍，或下载桌面试玩。',
	target: '目标塔', strength: '击打力度', hit: '敲击', reset: '重置六座塔', view: '重置视角',
	hits: '冲击次数', fallen: '倒下的塔', controls: '刚体塔控制',
	names: ['橡木', '红砖', '云杉', '石砖', '铜块', '白色混凝土'],
	desktop: '下载桌面试玩', credits: '第三方许可',
	note: '这是 MujoCraft 刚体玩法的网页版本，六座塔沿用桌面试玩存档的布局。完整模组和实时机器人仍需桌面客户端。',
} : {
	title: 'Mod playtest', section: 'Rigid-body tower lab', web: 'Browser playtest', home: 'Back to homepage', language: '简体中文',
	loading: 'Loading the physics scene…', live: 'Live simulation', offline: 'Simulation offline',
	unavailable: 'The simulation could not start on this device. You can still tour the museum or download the desktop demo.',
	target: 'Target tower', strength: 'Strike strength', hit: 'Strike', reset: 'Reset all towers', view: 'Reset camera',
	hits: 'Strikes', fallen: 'Toppled towers', controls: 'Tower controls',
	names: ['Oak', 'Red brick', 'Spruce', 'Stone brick', 'Copper', 'White concrete'],
	desktop: 'Download desktop demo', credits: 'Third-party licenses',
	note: 'This browser version of MujoCraft’s rigid-body gameplay uses the six-tower layout from the desktop save. The full mods and live robots require the desktop client.',
};
---
<!doctype html>
<html lang={zh ? 'zh-CN' : 'en'}>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{t.title} · MujoVerse</title>
	<meta name="description" content={t.note} />
	<link rel="icon" href="/favicon-48.png" />
	<link rel="alternate" hreflang={zh ? 'en' : 'zh-CN'} href={alternate} />
</head>
<body>
	<header class="bar">
		<a class="brand" href={home} aria-label={`MujoVerse: ${t.home}`}>
			<img src="/avatar-256.png" width="28" height="28" alt="" /> MujoVerse
		</a>
		<a class="language" href={alternate} lang={zh ? 'en' : 'zh-CN'}>{t.language}</a>
	</header>
	<main data-tower-lab data-running={t.live} data-offline={t.offline} data-unavailable={t.unavailable} data-state="loading">
		<div class="heading wrap">
			<div>
				<p class="eyebrow">MUJOCRAFT <span>/</span> {t.web}</p>
				<h1>{t.title}</h1>
			</div>
			<h2>{t.section}</h2>
		</div>

		<section class="stage" aria-label={t.section}>
			<div class="canvas-host" data-canvas>
				<img class="poster" data-poster src="/media/physics-lab.webp" alt="" fetchpriority="high" />
			</div>
			<div class="stage-top wrap">
				<div class="readout" role="status">
					<span class="indicator" aria-hidden="true"></span><span data-live>{t.web}</span>
					<span class="engine">MuJoCo 3.8</span>
				</div>
				<button class="icon-btn camera" type="button" title={t.view} aria-label={t.view} data-camera disabled>
					<Focus size={20} aria-hidden="true" />
				</button>
			</div>
			<p class="message" data-message role="status">{t.loading}</p>
			<noscript><p class="message">{t.unavailable}</p></noscript>
		</section>

		<section class="bench" aria-label={t.controls}>
			<div class="toolbar wrap">
				<div class="target-group">
					<div class="target-heading">
						<span class="label" id="tower-target-label">{t.target}</span>
						<span class="target-name" data-target aria-live="polite">{t.names[0]}</span>
					</div>
					<div class="choices" role="group" aria-labelledby="tower-target-label">
						{towers.map(({ color, id }, i) => (
							<button class="choice" type="button" data-tower={id} aria-label={t.names[i]}
								title={t.names[i]} aria-pressed={i === 0 ? 'true' : 'false'} disabled>
								<span class="swatch" style={`--swatch: ${color}`}></span><span>{String(i + 1).padStart(2, '0')}</span>
							</button>
						))}
					</div>
				</div>

				<div class="power">
					<div class="target-heading"><label class="label" for="tower-strength">{t.strength}</label>
						<output id="tower-strength-value" for="tower-strength" data-strength-value>70%</output></div>
					<input id="tower-strength" data-strength type="range" min="25" max="100" step="5" value="70" disabled />
				</div>

				<div class="commands">
					<button class="strike" type="button" data-strike disabled><Hammer size={19} aria-hidden="true" />{t.hit}</button>
					<button class="icon-btn" type="button" title={t.reset} aria-label={t.reset} data-reset disabled>
						<RotateCcw size={19} aria-hidden="true" />
					</button>
				</div>

				<dl class="stats">
					<div><dt>{t.hits}</dt><dd data-hits>0</dd></div>
					<div><dt>{t.fallen}</dt><dd data-fallen>0 / 6</dd></div>
				</dl>
			</div>
		</section>

		<footer class="wrap">
			<p>{t.note}</p>
			<div>
				<a href={home}><ArrowLeft size={15} aria-hidden="true" />{t.home}</a>
				<a href={`${home}guide/museum/`}>{t.desktop}<ArrowUpRight size={15} aria-hidden="true" /></a>
				<a href={`${home}about/licenses/#${zh ? '网页模组试玩' : 'browser-mod-playtest'}`}>{t.credits}</a>
			</div>
		</footer>
	</main>
	<script>
		import { startTowerLab } from '../museum/tower-lab.js';
		const lab = document.querySelector('[data-tower-lab]');
		if (lab) void startTowerLab(lab);
	</script>
</body>
</html>

<style is:global>
	:root {
		color-scheme: dark; color: #edf2ed; background: #141a1b; font-family: system-ui, sans-serif;
		--rule: #3b4747; --muted: #aab9b6; --mint: #9be8cd; --amber: #ffcb74;
	}
	* { box-sizing: border-box; }
	body { margin: 0; }
	.wrap { width: min(calc(100% - 40px), 1312px); margin-inline: auto; }
	.bar {
		display: flex; justify-content: space-between; align-items: center; min-height: 60px;
		padding: 0 max(20px, calc((100% - 1312px) / 2)); border-bottom: 1px solid var(--rule);
	}
	.bar a { color: inherit; text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
	.brand { gap: 10px; font-weight: 750; }
	.bar .language { color: var(--muted); font-size: .875rem; }
	.bar .language:hover, footer a:hover { color: var(--mint); }
	.heading { display: flex; align-items: end; justify-content: space-between; gap: 12px 24px; flex-wrap: wrap; padding: 20px 0 16px; }
	.eyebrow, .engine, .stats dd, output, .choice {
		font-family: ui-monospace, "Cascadia Mono", Consolas, monospace; font-variant-numeric: tabular-nums;
	}
	.eyebrow { color: var(--mint); font-size: .75rem; font-weight: 650; margin: 0 0 6px; }
	.eyebrow span { color: #81908d; padding-inline: 5px; }
	h1 { font-size: 2.3rem; line-height: 1.15; margin: 0; overflow-wrap: anywhere; }
	h2 { margin: 0 0 4px; color: var(--muted); font-size: 1rem; font-weight: 650; }
	.stage { position: relative; height: clamp(360px, 55svh, 690px); background: #20282b; isolation: isolate; border-block: 1px solid var(--rule); }
	.canvas-host, .canvas-host canvas, .poster { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
	.canvas-host canvas { touch-action: none; cursor: grab; }
	.canvas-host canvas:active { cursor: grabbing; }
	.poster { object-fit: cover; }
	.stage-top {
		position: relative; display: flex; align-items: flex-start; justify-content: space-between;
		gap: 8px; padding-top: 14px; pointer-events: none;
	}
	.readout {
		display: flex; align-items: center; gap: 8px; min-height: 36px; padding: 6px 10px;
		border: 1px solid #4c5858; background: #151c1de8; border-radius: 5px; color: #e1eae5; font-size: .75rem;
	}
	.indicator { width: 8px; height: 8px; border-radius: 50%; background: var(--amber); }
	[data-state="ready"] .indicator { background: #7ddbbb; }
	.engine { margin-left: 3px; padding-left: 9px; border-left: 1px solid #5b6766; color: #b7c6c3; }
	.message {
		position: absolute; bottom: 14px; margin: 0; left: 50%; transform: translateX(-50%);
		width: max-content; max-width: calc(100% - 32px); background: #151c1d; padding: 10px 14px; border: 1px solid var(--rule);
		font-size: .875rem; line-height: 1.45; border-radius: 5px;
	}
	.bench { background: #1d2627; border-bottom: 1px solid var(--rule); }
	.toolbar { display: grid; grid-template-columns: auto minmax(140px, 1fr) auto auto; gap: 20px; align-items: end; padding-block: 14px; }
	.label, .stats dt { font-size: .75rem; font-weight: 650; color: var(--muted); }
	.target-heading { display: flex; gap: 8px; justify-content: space-between; align-items: baseline; margin-bottom: 7px; min-height: 18px; }
	.target-name, output { font-size: .8rem; color: var(--amber); }
	.choices, .commands { display: flex; gap: 6px; align-items: center; }
	button {
		display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 44px;
		font: inherit; color: inherit; background: #262f30; border: 1px solid #50605e; border-radius: 5px; cursor: pointer;
	}
	button:not(:disabled):hover { border-color: #a0afaa; background: #333e3d; }
	button:focus-visible, a:focus-visible, input:focus-visible { outline: 2px solid var(--mint); outline-offset: 3px; }
	button:disabled, input:disabled { opacity: .6; cursor: default; }
	.choice { padding: 0; width: 46px; min-width: 0; gap: 4px; font-size: .68rem; }
	.choice[aria-pressed="true"] { border-color: var(--amber); color: var(--amber); background: #382f22; }
	.swatch { width: 12px; height: 12px; border-radius: 2px; background: var(--swatch); box-shadow: inset 0 0 0 1px #ffffff35; }
	.power { min-width: 0; }
	input[type="range"] { display: block; margin: 0; width: 100%; height: 44px; accent-color: var(--amber); }
	.strike { min-width: 110px; padding: 0 12px; background: var(--amber); border-color: var(--amber); color: #2a2116; font-weight: 750; }
	.strike:not(:disabled):hover { background: #ffdc9f; border-color: #ffdc9f; }
	.icon-btn { width: 44px; flex-shrink: 0; }
	.camera { pointer-events: auto; background: #151c1de8; }
	.stats { display: flex; gap: 18px; border-left: 1px solid var(--rule); margin: 0; padding: 0 0 0 18px; min-height: 44px; align-items: center; }
	.stats dd { color: #e5efea; font-size: 1.1rem; font-weight: 650; margin: 3px 0 0; white-space: nowrap; }
	footer { padding-block: 14px 28px; color: var(--muted); font-size: .875rem; line-height: 1.6; }
	footer p { margin: 0 0 10px; }
	footer div { display: flex; flex-wrap: wrap; gap: 6px 18px; }
	footer a { display: inline-flex; align-items: center; gap: 5px; color: #d6e9e2; text-underline-offset: 4px; }
	[hidden] { display: none !important; }
	@media (max-width: 900px) {
		.toolbar { grid-template-columns: auto minmax(120px, 1fr) auto; gap: 12px 16px; }
		.stats { grid-column: 1 / -1; border: 0; border-top: 1px solid var(--rule); padding: 7px 0 0; }
		.stats div { display: flex; align-items: baseline; gap: 7px; }
		.stats dd { margin: 0; }
	}
	@media (max-width: 660px) {
		.wrap { width: calc(100% - 32px); }
		.bar { min-height: 48px; padding-inline: 16px; }
		.heading { padding: 12px 0 8px; gap: 8px; }
		h1 { font-size: 1.65rem; }
		.stage { height: clamp(280px, 42svh, 420px); }
		.stage-top { padding-top: 9px; }
		.toolbar { grid-template-columns: minmax(0, 1fr) auto; gap: 10px 12px; padding-block: 10px; }
		.target-group { grid-column: 1 / -1; }
		.target-heading { margin-bottom: 4px; }
		.choices { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); }
		.choice { width: 100%; }
		.stats { min-height: 36px; }
	}
	@media (max-width: 360px) {
		.choice { gap: 3px; font-size: .59rem; }
		.swatch { width: 10px; height: 10px; }
		.strike { min-width: 80px; }
	}
</style>
